{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DelphEye",
  "version": "0.2.0",
  "identifier": "com.delpheye.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sensors && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DelphEye",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0F1216"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/DelphEye.Sensors.exe": "DelphEye.Sensors.exe"
    },
    "publisher": "DelphEye",
    "shortDescription": "DelphEye — Windows checkup, cleanup and monitoring",
    "longDescription": "Checks first, then lets you choose: cleanup, app leftovers, startup, disk, monitoring, processes, network and protection.",
    "copyright": "© 2026",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Ukrainian",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2RkQyRDZEMUQzRDg3NzkKUldSNWh6MGRiUzM5UnFOZCtBdStaYUtmTDk3S3NZRmFaQXk5YTQ3dDJ3VDRTMFdlNHhTTzRnUDQK",
      "endpoints": [
        "https://github.com/derr-hub/delpheye/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
